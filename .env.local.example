NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.com/graphql
REVALIDATION_SECRET=your-secret-token-here

# PostHog analytics (optional). Leave these commented out locally: analytics
# are disabled whenever the token is unset. Production values live in Vercel.
